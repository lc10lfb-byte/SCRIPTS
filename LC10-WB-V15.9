        while task.wait(60) do
            if not hidden and not streamHidden then
                local vu = game:GetService("VirtualUser")
                pcall(function()
                    vu:Button2Down(Vector2.new(0,0), Camera.CFrame)
                    task.wait(1)
                    vu:Button2Up(Vector2.new(0,0), Camera.CFrame)
                end)
            end
        end
    end)
end

--=======================  SPEED/JUMP  =======================
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            if hidden then return end
            local ch = LP.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            if hum then
                if C.SpeedEnabled then hum.WalkSpeed = C.SpeedValue end
                if C.JumpEnabled then hum.UseJumpPower = true hum.JumpPower = C.JumpValue end
            end
        end)
    end
end)

