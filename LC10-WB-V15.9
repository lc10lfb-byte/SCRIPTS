local function applyTexturePack(on)
    local state = _G.FxFPSState
    if on then
        state.originalLighting = {
            Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
            Brightness = Lighting.Brightness, GlobalShadows = Lighting.GlobalShadows,
            FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart, FogColor = Lighting.FogColor,
            EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
            EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
        }
        local sky = Lighting:FindFirstChildOfClass("Sky")
        if sky then state.originalSky = sky:Clone() sky.Parent = nil end
        local atm = Lighting:FindFirstChildOfClass("Atmosphere")
        if atm then state.originalAtmosphere = atm:Clone() atm.Parent = nil end
        local clouds = Lighting:FindFirstChildOfClass("Clouds")
        if clouds then state.originalClouds = clouds:Clone() clouds.Parent = nil end
        state.originalEffects = {}
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") then
                table.insert(state.originalEffects, { obj = v, prop = "Enabled", val = v.Enabled })
                v.Enabled = false
            end
        end
        pcall(function()
            Lighting.Ambient = Color3.fromRGB(180, 180, 180)
            Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
            Lighting.Brightness = 3
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 1e9
            Lighting.FogStart = 1e9
            Lighting.FogColor = Color3.fromRGB(255, 255, 255)
            Lighting.EnvironmentDiffuseScale = 0
            Lighting.EnvironmentSpecularScale = 0
        end)
        state.originalParts = {}
        task.spawn(function()
            for _, v in ipairs(workspace:GetDescendants()) do
                pcall(function()
                    if v:IsA("Decal") then
                        table.insert(state.originalParts, { obj = v, prop = "Transparency", val = v.Transparency })
                        v.Transparency = 1
                    elseif v:IsA("SurfaceAppearance") then
                        for _, prop in ipairs({"ColorMap", "NormalMap", "RoughnessMap", "MetalnessMap"}) do
                            local val = v[prop]
                            if val and val ~= "" then
                                table.insert(state.originalParts, { obj = v, prop = prop, val = val })
                                v[prop] = ""
                            end
                        end
                    elseif v:IsA("BasePart") then
                        table.insert(state.originalParts, { obj = v, prop = "Material", val = v.Material })
                        v.Material = Enum.Material.Plastic
                        if v.Reflectance ~= 0 then
                            table.insert(state.originalParts, { obj = v, prop = "Reflectance", val = v.Reflectance })
                            v.Reflectance = 0
                        end
                        if v:IsA("MeshPart") and v.TextureID and v.TextureID ~= "" then
                            table.insert(state.originalParts, { obj = v, prop = "TextureID", val = v.TextureID })
                            v.TextureID = ""
                        end
                        for _, m in ipairs(v:GetChildren()) do
                            if m:IsA("SpecialMesh") and m.TextureId and m.TextureId ~= "" then
                                table.insert(state.originalParts, { obj = m, prop = "TextureId", val = m.TextureId })
                                m.TextureId = ""
                            end
                        end
                    end
                end)
            end
        end)
    else
        for k, val in pairs(state.originalLighting or {}) do
            pcall(function() Lighting[k] = val end)
        end
        if state.originalSky then state.originalSky.Parent = Lighting state.originalSky = nil end
        if state.originalAtmosphere then state.originalAtmosphere.Parent = Lighting state.originalAtmosphere = nil end
        if state.originalClouds then state.originalClouds.Parent = Lighting state.originalClouds = nil end
        for _, item in ipairs(state.originalEffects or {}) do
            pcall(function() item.obj[item.prop] = item.val end)
        end
        state.originalEffects = {}
        for _, item in ipairs(state.originalParts or {}) do
            pcall(function() item.obj[item.prop] = item.val end)
        end
        state.originalParts = {}
    end
end

