    while task.wait(0.033) do
        if hidden or streamHidden or not hasDrawing then continue end
        if not (C.SkeletonESP or C.BoxESP or C.BoxV2ESP or C.TracerESP or C.ESPHealth) then continue end
        for _, plr in ipairs(cachedPlayers) do
            if plr == LP or not isAlive(plr) then
                if skelCache[plr] then for _, l in ipairs(skelCache[plr]) do l.Visible = false end end
                if boxCache[plr] then for _, l in ipairs(boxCache[plr]) do l.Visible = false end end
                if boxV2Cache[plr] then boxV2Cache[plr].rect.Visible = false boxV2Cache[plr].fill.Visible = false end
                if tracerCache[plr] then tracerCache[plr].Visible = false end
                if hpCache[plr] then hpCache[plr].Visible = false end
            else
                local ch = plr.Character
                local skip = C.ESPTeamCheck and sameTeam(LP, plr)
                if C.SkeletonESP and not skip then
                    if not skelCache[plr] then
                        skelCache[plr] = {}
                        for i = 1, #SKEL do skelCache[plr][i] = newLine(C.SkeletonColor) end
                    end
                    for i, pair in ipairs(SKEL) do
                        local p1 = ch:FindFirstChild(pair[1])
                        local p2 = ch:FindFirstChild(pair[2])
                        local line = skelCache[plr][i]
                        if p1 and p2 then
                            local s1, on1 = Camera:WorldToViewportPoint(p1.Position)
                            local s2, on2 = Camera:WorldToViewportPoint(p2.Position)
                            if on1 and on2 then
                                line.From = Vector2.new(s1.X, s1.Y)
                                line.To = Vector2.new(s2.X, s2.Y)
                                line.Color = C.SkeletonColor line.Visible = true
                            else line.Visible = false end
                        else line.Visible = false end
                    end
                elseif skelCache[plr] then
                    for _, l in ipairs(skelCache[plr]) do l.Visible = false end
                end
                if C.BoxESP and not skip then
                    if not boxCache[plr] then boxCache[plr] = newBox(C.BoxColor) end
                    local x1, y1, x2, y2 = getBounds(ch, plr)
                    if x1 then
                        local L = boxCache[plr]
                        L[1].From=Vector2.new(x1,y1) L[1].To=Vector2.new(x2,y1)
                        L[2].From=Vector2.new(x2,y1) L[2].To=Vector2.new(x2,y2)
                        L[3].From=Vector2.new(x2,y2) L[3].To=Vector2.new(x1,y2)
                        L[4].From=Vector2.new(x1,y2) L[4].To=Vector2.new(x1,y1)
                        for i=1,4 do L[i].Color=C.BoxColor L[i].Visible=true end
                    else for i=1,4 do boxCache[plr][i].Visible=false end end
                elseif boxCache[plr] then
                    for _, l in ipairs(boxCache[plr]) do l.Visible = false end
                end
                if C.BoxV2ESP and not skip then
                    if not boxV2Cache[plr] then
                        boxV2Cache[plr] = { rect=newRect(C.BoxV2Color), fill=newFillRect(C.BoxV2Color) }
                    end
                    local x1, y1, x2, y2 = getBounds(ch, plr)
                    if x1 then
                        local r = boxV2Cache[plr].rect local f = boxV2Cache[plr].fill
                        local w, h = x2-x1, y2-y1
                        r.Position=Vector2.new(x1,y1) r.Size=Vector2.new(w,h) r.Color=C.BoxV2Color r.Visible=true
                        f.Position=Vector2.new(x1,y1) f.Size=Vector2.new(w,h) f.Color=C.BoxV2Color f.Visible=true
                    else boxV2Cache[plr].rect.Visible=false boxV2Cache[plr].fill.Visible=false end
                elseif boxV2Cache[plr] then
                    boxV2Cache[plr].rect.Visible = false boxV2Cache[plr].fill.Visible = false
                end
                if C.TracerESP and not skip then
                    if not tracerCache[plr] then tracerCache[plr] = newLine(C.TracerColor) end
                    local head = ch:FindFirstChild("Head")
                    if head then
                        local sp, on = Camera:WorldToViewportPoint(head.Position)
                        if on then
                            tracerCache[plr].From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                            tracerCache[plr].To = Vector2.new(sp.X, sp.Y)
                            tracerCache[plr].Color = C.TracerColor tracerCache[plr].Visible = true
                        else tracerCache[plr].Visible = false end
                    end
                elseif tracerCache[plr] then tracerCache[plr].Visible = false end
                if C.ESPHealth and not skip then
                    if not hpCache[plr] then hpCache[plr] = newText(Color3.fromRGB(80,255,80)) end
                    local hum = ch:FindFirstChildOfClass("Humanoid")
                    local head = ch:FindFirstChild("Head")
                    if hum and head then
                        local sp, on = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 2.5, 0))
                        if on then
                            hpCache[plr].Text = string.format("%d HP", math.floor(hum.Health))
                            hpCache[plr].Position = Vector2.new(sp.X, sp.Y)
                            hpCache[plr].Color = hum.Health > 50 and Color3.fromRGB(80,255,80)
                                              or hum.Health > 20 and Color3.fromRGB(255,220,80)
                                              or Color3.fromRGB(255,60,60)
                            hpCache[plr].Visible = true
                        else hpCache[plr].Visible = false end
                    end
                elseif hpCache[plr] then hpCache[plr].Visible = false end
            end
        end
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        if hidden or streamHidden then
            if next(espCache) then clearAllESP() end
            continue
        end
        if not C.ESP then
            if next(espCache) then clearAllESP() end
            continue
        end
        for _, plr in ipairs(cachedPlayers) do
            if plr ~= LP and isAlive(plr) then
                if C.ESPTeamCheck and sameTeam(LP, plr) then removeESP(plr) continue end
                if not espCache[plr] or not espCache[plr].highlight then
                    removeESP(plr) createESP(plr)
                end
                local d = espCache[plr]
                if d then
                    if d.highlight then d.highlight.FillColor = C.ESPColor end
                    if d.name then d.name.Visible = C.ESPNames d.name.Text = plr.Name end
                    if d.dist then
                        if C.ESPDist then
                            local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                            if root then
                                local dd = (root.Position - cachedMyPos).Magnitude
                                d.dist.Text = string.format("[%d studs]", math.floor(dd))
                                d.dist.Visible = true
                            end
                        else d.dist.Visible = false end
                    end
                    if d.wpn then
                        if C.ESPWeapon then
                            local tool = plr.Character and plr.Character:FindFirstChildOfClass("Tool")
                            d.wpn.Text = tool and tool.Name or ""
                            d.wpn.Visible = true
                        else d.wpn.Visible = false end
                    end
                end
            else removeESP(plr) end
        end
    end
end)

