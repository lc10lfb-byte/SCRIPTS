function _G.FxRegisterTap()
    if not C.PanicEnabled then return end
    if tick() - _G.FxLastPanicTrigger < 1 then return end
    _G.FxPruneTaps()
    table.insert(_G.FxTapTimestamps, tick())
    if #_G.FxTapTimestamps >= C.PanicTaps then
        _G.FxLastPanicTrigger = tick()
        _G.FxTapTimestamps = {}
        _G.FxTogglePanic(not hidden)
    end
end

