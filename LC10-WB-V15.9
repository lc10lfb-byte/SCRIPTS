local function addSlider(tab, opts)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 52)
    row.BackgroundColor3 = T.surface row.BorderSizePixel = 0 row.Parent = tab.Page
    corner(row, 8)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1 l.Text = opts.Title or ""
    l.Font = Enum.Font.GothamMedium l.TextSize = 13 l.TextColor3 = T.text
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Position = UDim2.new(0, 12, 0, 4) l.Size = UDim2.new(1, -80, 0, 20) l.Parent = row
    local min, max = opts.Min or 0, opts.Max or 100
    local val = opts.Value or min
    local valLbl = Instance.new("TextLabel")
    valLbl.BackgroundTransparency = 1 valLbl.Text = tostring(val)
    valLbl.Font = Enum.Font.GothamBold valLbl.TextSize = 12 valLbl.TextColor3 = T.accent
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.Position = UDim2.new(1, -70, 0, 4) valLbl.Size = UDim2.new(0, 58, 0, 20) valLbl.Parent = row
    local trackBg = Instance.new("Frame")
    trackBg.Size = UDim2.new(1, -24, 0, 6) trackBg.Position = UDim2.new(0, 12, 1, -20)
    trackBg.BackgroundColor3 = T.off trackBg.BorderSizePixel = 0 trackBg.Parent = row
    corner(trackBg, 3)
    local p0 = (val - min) / (max - min)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(p0, 0, 1, 0) fill.BackgroundColor3 = T.accent
    fill.BorderSizePixel = 0 fill.Parent = trackBg
    corner(fill, 3)
    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5, 0.5) knob.Size = UDim2.fromOffset(14, 14)
    knob.Position = UDim2.new(p0, 0, 0.5, 0) knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
    knob.BorderSizePixel = 0 knob.Parent = trackBg
    corner(knob, 7)
    local drag, step = false, opts.Step or 1
    local function upd(input)
        local rel = math.clamp((input.Position.X - trackBg.AbsolutePosition.X) / trackBg.AbsoluteSize.X, 0, 1)
        local nv = math.floor((min + rel * (max - min)) / step + 0.5) * step
        nv = math.clamp(nv, min, max)
        val = nv
        valLbl.Text = step < 1 and string.format("%.2f", val) or tostring(math.floor(val))
        local pp = (val - min) / (max - min)
        fill.Size = UDim2.new(pp, 0, 1, 0) knob.Position = UDim2.new(pp, 0, 0.5, 0)
        if opts.Callback then opts.Callback(val) end
    end
    trackBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then drag = true upd(input) end
    end)
    trackBg.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then drag = false end
    end)
    UIS.InputChanged:Connect(function(input)
        if drag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then upd(input) end
    end)
    return {
        Set = function(v)
            val = math.clamp(v, min, max)
            valLbl.Text = step < 1 and string.format("%.2f", val) or tostring(math.floor(val))
            local pp = (val - min) / (max - min)
            fill.Size = UDim2.new(pp, 0, 1, 0) knob.Position = UDim2.new(pp, 0, 0.5, 0)
            if opts.Callback then opts.Callback(val) end
        end
    }
end

