                lbl.BackgroundTransparency = 1 lbl.Text = plr.Name
                lbl.Font = Enum.Font.Gotham lbl.TextSize = 12 lbl.TextColor3 = T.text
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.Position = UDim2.new(0, 8, 0, 0) lbl.Size = UDim2.new(1, -40, 1, 0) lbl.Parent = row
                local check = Instance.new("TextLabel")
                check.BackgroundTransparency = 1 check.Text = ""
                check.Font = Enum.Font.GothamBold check.TextSize = 14 check.TextColor3 = selColor
                check.Position = UDim2.new(1, -26, 0, 0) check.Size = UDim2.new(0, 22, 1, 0) check.Parent = row
                local function updateVis()
                    if current[plr.UserId] then
                        row.BackgroundTransparency = 0.65
                        row.BackgroundColor3 = selColor
                        check.Text = "✓"
                    else
                        row.BackgroundTransparency = 1
                        check.Text = ""
                    end
                end
                updateVis()
                row.MouseButton1Click:Connect(function()
                    if current[plr.UserId] then current[plr.UserId] = nil
                    else
                        current[plr.UserId] = true
                        if opts.OnAdd then opts.OnAdd(plr.UserId) end
                    end
                    updateVis()
                    local c = 0
                    for _ in pairs(current) do c = c + 1 end
                    countLbl.Text = tostring(c)
                end)
            end
        end
    end
    refresh()
    return { Refresh = refresh }
end

--=======================  HELPERS  ==========================
function serverHop()
    task.spawn(function()
        local req = request or http_request or (syn and syn.request)
        if not req then return end
        local placeId = game.PlaceId
        local url = "https://games.roblox.com/v1/games/"..placeId.."/servers/Public?limit=100"
        local ok, res = pcall(req, { Url = url, Method = "GET" })
        if not ok or not res or not res.Body then return end
        local data = game:GetService("HttpService"):JSONDecode(res.Body)
        for _, srv in ipairs(data.data or {}) do
            if srv.id ~= game.JobId and srv.playing < srv.maxPlayers then
                pcall(function() game:GetService("TeleportService"):TeleportToPlaceInstance(placeId, srv.id, LP) end)
                return
            end
        end
    end)
end
function spectatePlayer(name)
    local t = Players:FindFirstChild(name)
    if not t or not t.Character then return end
    local head = t.Character:FindFirstChild("Head")
    if head then Camera.CameraSubject = head end
end
function stopSpectate()
    local hum = LP.Character and LP:FindFirstChildOfClass("Humanoid")
    if hum then Camera.CameraSubject = hum end
end
function teleportToPlayer(name)
    local t = Players:FindFirstChild(name)
    if not t or not t.Character then return end
    local myR = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local tgR = t.Character:FindFirstChild("HumanoidRootPart")
    if myR and tgR then myR.CFrame = tgR.CFrame + Vector3.new(0,3,0) end
end
function getHumaPreset(style)
    if style == "Casual" then return { reaction = 250, overshoot = 20, jitter = 4, precision = 40 }
    elseif style == "Bom" then return { reaction = 180, overshoot = 15, jitter = 2, precision = 60 }
    elseif style == "Pro" then return { reaction = 130, overshoot = 10, jitter = 1, precision = 80 }
    elseif style == "Sweat" then return { reaction = 90, overshoot = 5, jitter = 0.5, precision = 95 }
    end
    return { reaction = 180, overshoot = 15, jitter = 2, precision = 60 }
end

