--=======================  PANIC  ============================
_G.FxTapTimestamps = {}
_G.FxLastPanicTrigger = 0

function _G.FxPruneTaps()
    local now = tick()
    local newList = {}
    for _, t in ipairs(_G.FxTapTimestamps) do
        if now - t <= C.PanicWindow then table.insert(newList, t) end
    end
    _G.FxTapTimestamps = newList
end

local function destroyDrawing(obj)
    if obj == nil then return end
    local ok = pcall(function() obj:Remove() end)
    if ok then return end
    if type(obj) == "table" then
        for _, sub in pairs(obj) do
            if sub ~= nil then
                pcall(function() sub:Remove() end)
                if type(sub) == "table" then
                    for _, ssub in pairs(sub) do pcall(function() ssub:Remove() end) end
                end
            end
        end
    end
end

function _G.FxHideAllDrawings()
    local caches = {_G.FxSkelCache, _G.FxBoxCache, _G.FxBoxV2Cache, _G.FxTracerCache, _G.FxHpCache}
    for _, cache in ipairs(caches) do
        for key, data in pairs(cache) do
            destroyDrawing(data)
            cache[key] = nil
        end
    end
    for plr, data in pairs(_G.FxEspCache) do
        if data.highlight then pcall(function() data.highlight:Destroy() end) end
        if data.billboard then pcall(function() data.billboard:Destroy() end) end
        _G.FxEspCache[plr] = nil
    end
end

function _G.FxTogglePanic(hide)
    hidden = hide
    if _G.FxMain then _G.FxMain.Visible = not hide end
    if _G.FxMinFloat then _G.FxMinFloat.Visible = false end
    if _G.FxFovGui then _G.FxFovGui.Enabled = not hide end
    if _G.FxAimFovGui then _G.FxAimFovGui.Enabled = not hide end
    if _G.FxAimGui then _G.FxAimGui.Enabled = not hide end
    if _G.FxHudGui then _G.FxHudGui.Enabled = not hide end
    if _G.FxHumaBtnGui then _G.FxHumaBtnGui.Enabled = not hide end
    if _G.FxHumaFovGui then _G.FxHumaFovGui.Enabled = not hide end
    if _G.FxSweatFovGui then _G.FxSweatFovGui.Enabled = not hide end
    if hide then _G.FxHideAllDrawings() end
end

function _G.FxToggleStream(on)
    C.Stream_Enabled = on
    streamHidden = on
    local function setV(gui, v) if gui then gui.Enabled = v end end
    if C.Stream_HideFOV then
        setV(_G.FxFovGui, not on)
