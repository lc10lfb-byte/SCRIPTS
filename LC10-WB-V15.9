        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire")
               or v:IsA("Sparkles") or v:IsA("Beam") or v:IsA("Trail") then
