local boundsCache = {}
local function getBounds(ch, plr)
    local cached = boundsCache[plr]
    if cached and tick() - cached.t < 0.1 then
        return cached.minX, cached.minY, cached.maxX, cached.maxY
    end
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local vis = false
    for _, part in ipairs(ch:GetChildren()) do
        if part:IsA("BasePart") then
            local pos, on = Camera:WorldToViewportPoint(part.Position)
            if on then
                vis = true
                local s = part.Size.Magnitude * 200 / (pos.Z + 1)
                minX = math.min(minX, pos.X - s/2)
                maxX = math.max(maxX, pos.X + s/2)
                minY = math.min(minY, pos.Y - s/2)
                maxY = math.max(maxY, pos.Y + s/2)
            end
        end
    end
    if not vis then return nil end
    boundsCache[plr] = { minX = minX, minY = minY, maxX = maxX, maxY = maxY, t = tick() }
    return minX, minY, maxX, maxY
end

