local fpsCounter = { frames = 0, lastUpdate = tick(), value = 60 }
local function applyInfoPanelPos()
    if not hudState.infoPanel then return end
    local pos = C.HUD_InfoPos
    if pos == "Top Esquerda" then
        hudState.infoPanel.AnchorPoint = Vector2.new(0, 0)
        hudState.infoPanel.Position = UDim2.new(0, 10, 0, 60)
    elseif pos == "Top Direita" then
        hudState.infoPanel.AnchorPoint = Vector2.new(1, 0)
        hudState.infoPanel.Position = UDim2.new(1, -10, 0, 60)
    elseif pos == "Baixo Esquerda" then
        hudState.infoPanel.AnchorPoint = Vector2.new(0, 1)
        hudState.infoPanel.Position = UDim2.new(0, 10, 1, -60)
    elseif pos == "Baixo Direita" then
        hudState.infoPanel.AnchorPoint = Vector2.new(1, 1)
        hudState.infoPanel.Position = UDim2.new(1, -10, 1, -60)
    end
end
local function applyHealthBarPos()
    if not hudState.healthBarBg then return end
    local pos = C.HUD_HealthPos
    if pos == "Baixo" then
        hudState.healthBarBg.AnchorPoint = Vector2.new(0.5, 1)
        hudState.healthBarBg.Position = UDim2.new(0.5, 0, 1, -80)
    elseif pos == "Cima" then
        hudState.healthBarBg.AnchorPoint = Vector2.new(0.5, 0)
        hudState.healthBarBg.Position = UDim2.new(0.5, 0, 0, 80)
    elseif pos == "Centro" then
        hudState.healthBarBg.AnchorPoint = Vector2.new(0.5, 0.5)
        hudState.healthBarBg.Position = UDim2.new(0.5, 0, 0.5, 60)
    end
end
local function applyCrosshair()
    if not hudState.crosshair then return end
    local style = C.HUD_CrosshairStyle
    local size = C.HUD_CrosshairSize
    local thick = C.HUD_CrosshairThick
    local dotSize = C.HUD_CrosshairDot
    local col = C.HUD_CrosshairColor
    hudState.crosshair.Visible = C.HUD_Crosshair
    if not C.HUD_Crosshair then return end
    local showH = style == "Cruz" or style == "Cruz + Ponto"
    local showV = style == "Cruz" or style == "Cruz + Ponto"
    local showDot = style == "Ponto" or style == "Cruz + Ponto"
    local showCircle = style == "Círculo"
    hudState.xH.Visible = showH hudState.xH.BackgroundColor3 = col hudState.xH.Size = UDim2.fromOffset(size * 2, thick)
    hudState.xV.Visible = showV hudState.xV.BackgroundColor3 = col hudState.xV.Size = UDim2.fromOffset(thick, size * 2)
    hudState.xDot.Visible = showDot hudState.xDot.BackgroundColor3 = col hudState.xDot.Size = UDim2.fromOffset(dotSize, dotSize)
    hudState.xCircle.Visible = showCircle hudState.xCircle.Size = UDim2.fromOffset(size * 2, size * 2)
    hudState.xCircleStroke.Color = col hudState.xCircleStroke.Thickness = thick
end
local function setHideDefaultHUD(on)
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end
    if on then
        hiddenHUD = {}
        for _, gui in ipairs(pg:GetChildren()) do
            if gui:IsA("ScreenGui") and not gui.Name:find("LC10") then
                if gui.Enabled then table.insert(hiddenHUD, gui) gui.Enabled = false end
            end
        end
    else
        for _, gui in ipairs(hiddenHUD) do pcall(function() gui.Enabled = true end) end
        hiddenHUD = {}
    end
end
local function setHideGameElem(name, on)
    local pg = LP:FindFirstChild("PlayerGui")
    if not pg then return end
    local el = pg:FindFirstChild(name)
    if el then el.Enabled = not on end
end
local function getPing()
    local ok, ping = pcall(function()
        return math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
    end)
    return ok and ping or 0
end
local function getRAM()
    local ok, mb = pcall(function()
        return math.floor(Stats:GetTotalMemoryUsageMb())
    end)
    return ok and mb or 0
end

task.spawn(function()
    while task.wait(0.25) do
        if not hudState.gui or hidden or streamHidden then continue end
        applyCrosshair() applyInfoPanelPos() applyHealthBarPos()
        local showAny = C.HUD_ShowFPS or C.HUD_ShowPing or C.HUD_ShowRAM or C.HUD_ShowPlayers or C.HUD_ShowCoords or C.HUD_ShowTime
        hudState.infoPanel.Visible = showAny
        if C.HUD_ShowFPS then hudState.fpsLbl.Visible = true hudState.fpsLbl.Text = "FPS: " .. fpsCounter.value else hudState.fpsLbl.Visible = false end
        if C.HUD_ShowPing then hudState.pingLbl.Visible = true hudState.pingLbl.Text = "Ping: " .. getPing() .. "ms" else hudState.pingLbl.Visible = false end
        if C.HUD_ShowRAM then hudState.ramLbl.Visible = true hudState.ramLbl.Text = "RAM: " .. getRAM() .. "MB" else hudState.ramLbl.Visible = false end
        if C.HUD_ShowPlayers then hudState.playersLbl.Visible = true hudState.playersLbl.Text = "Players: " .. #Players:GetPlayers() else hudState.playersLbl.Visible = false end
        if C.HUD_ShowCoords then
            local ch = LP.Character
            local root = ch and ch:FindFirstChild("HumanoidRootPart")
            if root then
                local p = root.Position
                hudState.coordsLbl.Visible = true
                hudState.coordsLbl.Text = string.format("XYZ: %d, %d, %d", p.X, p.Y, p.Z)
            else hudState.coordsLbl.Visible = false end
        else hudState.coordsLbl.Visible = false end
        if C.HUD_ShowTime then hudState.timeLbl.Visible = true hudState.timeLbl.Text = os.date("%H:%M:%S") else hudState.timeLbl.Visible = false end
        if C.HUD_HealthBar then
            local ch = LP.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            if hum then
                hudState.healthBarBg.Visible = true
                local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                hudState.healthBar.Size = UDim2.new(pct, -4, 1, -4)
                local r, g, b
                if pct > 0.5 then r, g, b = 80, 220, 120
                elseif pct > 0.25 then r, g, b = 255, 200, 80
                else r, g, b = 255, 60, 60 end
                hudState.healthBar.BackgroundColor3 = Color3.fromRGB(r, g, b)
                hudState.healthLbl.Text = math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
            else hudState.healthBarBg.Visible = false end
        else hudState.healthBarBg.Visible = false end
        hudState.watermark.Visible = C.HUD_Watermark
    end
end)

