    local page = Instance.new("ScrollingFrame")
    page.Name = name page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1 page.BorderSizePixel = 0
    page.ScrollBarThickness = 3 page.ScrollBarImageColor3 = T.border
    page.CanvasSize = UDim2.new(0, 0, 0, 0) page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false page.Parent = content
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 10) pad.PaddingRight = UDim.new(0, 10)
    pad.PaddingTop = UDim.new(0, 10) pad.PaddingBottom = UDim.new(0, 10)
    pad.Parent = page
    local lay = Instance.new("UIListLayout")
    lay.Padding = UDim.new(0, 6) lay.SortOrder = Enum.SortOrder.LayoutOrder lay.Parent = page

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -12, 0, 32)
    btn.BackgroundColor3 = T.surface btn.BackgroundTransparency = 1
    btn.BorderSizePixel = 0 btn.Text = "" btn.AutoButtonColor = false btn.Parent = sidebar
    corner(btn, 6)
    local d = Instance.new("Frame")
    d.Size = UDim2.fromOffset(6, 6) d.Position = UDim2.new(0, 10, 0.5, -3)
    d.BackgroundColor3 = T.dim d.BorderSizePixel = 0 d.Parent = btn
    corner(d, 3)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1 l.Text = name
    l.Font = Enum.Font.GothamMedium l.TextSize = 13 l.TextColor3 = T.dim
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Position = UDim2.new(0, 24, 0, 0) l.Size = UDim2.new(1, -28, 1, 0) l.Parent = btn

    local tabData = { Page = page, Btn = btn, Dot = d, Lbl = l }
    local function activate()
        if currentTab == tabData then return end
        currentTab = tabData
        for _, t in ipairs(tabs) do t.Page.Visible = (t == tabData) end
        for _, t in ipairs(tabButtons) do
            local a = (t == tabData)
            Tween:Create(t.Btn, TweenInfo.new(0.2), { BackgroundTransparency = a and 0.1 or 1 }):Play()
            Tween:Create(t.Btn, TweenInfo.new(0.2), { BackgroundColor3 = a and T.accent or T.surface }):Play()
            Tween:Create(t.Dot, TweenInfo.new(0.2), { BackgroundColor3 = a and T.accent or T.dim }):Play()
            Tween:Create(t.Lbl, TweenInfo.new(0.2), { TextColor3 = a and T.text or T.dim }):Play()
        end
    end
    btn.MouseButton1Click:Connect(activate)
    table.insert(tabs, tabData) table.insert(tabButtons, tabData)
    if not currentTab then activate() end
    return tabData
end

