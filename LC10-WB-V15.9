--=======================  ALVO  =============================
local cachedMyPos = Vector3.zero
local cachedPlayers = {}

local function isAlive(p)
    local ch = p.Character
    local h = ch and ch:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end
local function sameTeam(a, b)
    return a and b and a.Team and b.Team and a.Team == b.Team
end

local civilTeamCache = {}
local function isCivilTeamName(tn)
    local cached = civilTeamCache[tn]
    if cached ~= nil then return cached end
    local result = tn:find("civil") ~= nil
                or tn:find("civilian") ~= nil
                or tn:find("citizen") ~= nil
                or tn == "civ"
    civilTeamCache[tn] = result
    return result
end
local function isCivil(plr)
    if not plr then return false end
    local team = plr.Team
    if not team or not team.Name then return false end
    return isCivilTeamName(team.Name:lower())
end

local function inFov(pos, radius)
    local screen, on = Camera:WorldToViewportPoint(pos)
    if not on then return false end
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    return (Vector2.new(screen.X, screen.Y) - center).Magnitude <= (radius or C.FovRadius)
end
local function canSee(targetPart)
    if not C.WallCheck then return true end
    local origin = cachedMyPos
    local dir = targetPart.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LP.Character }
    local result = workspace:Raycast(origin, dir, params)
    if not result then return true end
    local hit = result.Instance
    if hit and targetPart.Parent and hit:IsDescendantOf(targetPart.Parent) then return true end
    return false
end
local function pickTarget(partName, radius, teamCheck, priorityList, ignoreList, checkCivil)
    if #cachedPlayers < 2 then return nil end
    local best, bestScore = nil, math.huge
    local origin = cachedMyPos
    for _, plr in ipairs(cachedPlayers) do
        if plr ~= LP and isAlive(plr) then
            if ignoreList and ignoreList[plr.UserId] then continue end
            if checkCivil and isCivil(plr) then continue end
            local ch = plr.Character
            local part = ch:FindFirstChild(partName or "Head") or ch:FindFirstChild("Head")
            if part then
                if teamCheck and sameTeam(LP, plr) then continue end
                if not inFov(part.Position, radius) then continue end
                if not canSee(part) then continue end
                local dist = (part.Position - origin).Magnitude
                local score = dist
                if C.AimbotPrioCrosshair then
                    local sp = Camera:WorldToViewportPoint(part.Position)
                    local cx = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                    score = (Vector2.new(sp.X, sp.Y) - cx).Magnitude
                end
                if C.PrioLowHP then
                    local hum = ch:FindFirstChildOfClass("Humanoid")
                    score = hum and hum.Health or score
                end
                if priorityList and priorityList[plr.UserId] then
                    score = score - 1e6
                end
                if score < bestScore then
                    bestScore = score
                    best = { plr = plr, part = part, pos = part.Position }
                end
            end
        end
    end
    return best
end

