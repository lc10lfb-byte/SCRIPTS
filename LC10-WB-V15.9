local function sweatStep()
    if hidden or streamHidden then return end
    if not C.Sweat_Enabled then
        sweatTargetPlr = nil sweatStartTime = 0 sweatAimPos = nil
        _sweatCachedTarget = nil
        return
    end
    if C.Huma_Enabled or C.Aimbot then
        sweatTargetPlr = nil sweatAimPos = nil
        _sweatCachedTarget = nil
        return
    end

    local trig = false
    if C.Sweat_OnlyZoom and isZooming then trig = true end
    if not C.Sweat_OnlyZoom then trig = true end
    if not trig then
        sweatTargetPlr = nil sweatAimPos = nil
        _sweatCachedTarget = nil
        return
    end

    local now = tick()
    if now - sweatLastPick > 0.1 then
        sweatLastPick = now
        _sweatCachedTarget = pickTarget(C.Sweat_Part, C.Sweat_Fov, C.Sweat_TeamCheck, C.Sweat_PriorityList, C.Sweat_IgnoreList, false)
        if not _sweatCachedTarget then sweatAimPos = nil end
    end

    local sweatTarget = _sweatCachedTarget
    if not sweatTarget then
        sweatTargetPlr = nil sweatAimPos = nil
        return
    end

    local ch = sweatTarget.plr.Character
    local part = ch and ch:FindFirstChild(C.Sweat_Part) or (ch and ch:FindFirstChild("Head"))
    if not part then
        _sweatCachedTarget = nil sweatAimPos = nil
        return
    end
    local liveTargetPos = part.Position

    if sweatTargetPlr ~= sweatTarget.plr then
        sweatTargetPlr = sweatTarget.plr
        sweatStartTime = now
        sweatAimPos = liveTargetPos
    end

    local reactionSec = C.Sweat_Reaction / 1000
    if now - sweatStartTime < reactionSec then return end

    local root = ch:FindFirstChild("HumanoidRootPart")
    local vel = root and root.AssemblyLinearVelocity or Vector3.zero
    local predictOffset = Vector3.zero
    if C.Sweat_Predict > 0 and vel.Magnitude > 1 then
        local factor = (C.Sweat_Predict / 100) * 0.30
        predictOffset = vel * factor
        if predictOffset.Magnitude > 6 then
            predictOffset = predictOffset.Unit * 6
        end
    end

    local aimPos = liveTargetPos + predictOffset

    if not sweatAimPos then sweatAimPos = aimPos
    else sweatAimPos = sweatAimPos:Lerp(aimPos, 0.4) end

    local origin = Camera.CFrame.Position
    local tgtCF = CFrame.new(origin, sweatAimPos)

    local lockFactor = C.Sweat_LockStrength / 100
    local elapsed = now - sweatStartTime - reactionSec
    local easingFactor = math.clamp(elapsed / 0.15, 0.3, 1)
    local smooth = 0.65 + ((0.95 - 0.65) * easingFactor * lockFactor)
    smooth = math.clamp(smooth, 0.05, 0.98)

    Camera.CFrame = Camera.CFrame:Lerp(tgtCF, smooth)
end
pcall(function() RunService:UnbindFromRenderStep("FxSweat") end)
RunService:BindToRenderStep("FxSweat", 203, sweatStep)

