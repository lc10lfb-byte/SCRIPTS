local CONFIG_PATH = "LC10_position.json"
local FLOAT_SIZE = 56
local minFloat

local function getScreenBounds()
    local cam = workspace.CurrentCamera
    if not cam then return 1080, 1920 end
    local vp = cam.ViewportSize
    local w, h = vp.X, vp.Y
    if w < 100 then w = 1080 end
    if h < 100 then h = 1920 end
    return w, h
end
local function clampToScreen(x, y)
    local sw, sh = getScreenBounds()
    local maxX = math.max(8, sw - FLOAT_SIZE - 8)
    local maxY = math.max(8, sh - FLOAT_SIZE - 8)
    x = math.clamp(x, 8, maxX) y = math.clamp(y, 8, maxY)
    return x, y
end
local function getFloatAbsoluteXY()
    local sw, sh = getScreenBounds()
    local p = minFloat.Position
    local x = (p.X.Scale or 0) * sw + (p.X.Offset or 0)
    local y = (p.Y.Scale or 0) * sh + (p.Y.Offset or 0)
    x, y = clampToScreen(x, y)
    return x, y
end
local function setFloatAbsoluteXY(x, y)
    x, y = clampToScreen(x, y)
    minFloat.Position = UDim2.fromOffset(x, y)
    return x, y
end
local function loadPosition()
    if not readfile then return nil end
    local ok, data = pcall(readfile, CONFIG_PATH)
    if not ok or type(data) ~= "string" or #data < 5 then return nil end
    local decodeOk, pos = pcall(function() return game:GetService("HttpService"):JSONDecode(data) end)
    if not decodeOk or type(pos) ~= "table" then return nil end
    if type(pos.X) ~= "number" or type(pos.Y) ~= "number" then return nil end
    return { X = pos.X, Y = pos.Y }
end
local function savePosition(x, y)
    if not writefile then return end
    x, y = clampToScreen(x, y)
    pcall(function() writefile(CONFIG_PATH, game:GetService("HttpService"):JSONEncode({ X = x, Y = y })) end)
end

