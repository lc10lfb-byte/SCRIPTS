local function isPistol(name)
    name = name:lower()
    return name:find("pistol") or name:find("jolland") or name:find("glock") or
           name:find("usp") or name:find("deagle") or name:find("revolver") or
           name:find("m1911") or name:find("p250") or name:find("handgun") or
           name:find("sixshooter")
end
local function isBufalo(name)
    name = name:lower()
    return name:find("bufalo") or name:find("buffalo")
end
local function isFireSound(s)
    local sN = s.Name:lower()
    local match = (sN == "fire" or sN == "shoot" or sN == "shot"
                   or sN:find("fire") or sN:find("shoot") or sN:find("shot"))
    if not match then return false end
    if sN:find("reload") or sN:find("equip") or sN:find("empty") or sN:find("dry") then return false end
    return true
end
local function resolveSoundId(weaponType)
    if weaponType == "pistol" then
        if C.Custom_PistolSound then return PISTOL_SOUND_ID, 0.8 end
        if C.Custom_PistolAltSound and C.Custom_PistolAltSound ~= "Nenhum" then
            local id = SOUND_MAP.Pistol[C.Custom_PistolAltSound]
            if id then return id, 0.8 end
        end
    elseif weaponType == "rifle" then
        if C.Custom_RifleSound and C.Custom_RifleSound ~= "Nenhum" then
            local id = SOUND_MAP.Rifle[C.Custom_RifleSound]
            if id then return id, 0.8 end
        end
    end
    return nil, nil
end

local function applyWeaponCustomization(weaponModel, targetColor, applyGlass)
    if not weaponModel then return end
    for _, d in ipairs(weaponModel:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("MeshPart") then
            if not originalWeaponState[d] then
                originalWeaponState[d] = { Color = d.Color, Material = d.Material, Transparency = d.Transparency }
            end
            d.Color = targetColor
            if applyGlass then
                d.Material = Enum.Material.Glass
                d.Transparency = 0.35
            else
                d.Material = Enum.Material.SmoothPlastic
                d.Transparency = 0
            end
        end
    end
end

local function customAnyActive()
    return C.Custom_RifleEnabled or C.Custom_PistolEnabled
        or C.Custom_BufaloEnabled or C.Custom_Vidrom
        or C.Custom_PistolSound
        or (C.Custom_PistolAltSound and C.Custom_PistolAltSound ~= "Nenhum")
        or (C.Custom_RifleSound and C.Custom_RifleSound ~= "Nenhum")
end

local function processWeapons()
    local char = LP.Character
    if not char then return end
    local containers = { char, LP:FindFirstChild("Backpack") }
    local useGlass = C.Custom_Vidrom
    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetDescendants()) do
                if item:IsA("Model") or item:IsA("Tool") then
                    local n = item.Name
                    local anyActive = false
                    local weaponType = "rifle"
                    if isBufalo(n) then weaponType = "bufalo"
                    elseif isPistol(n) then weaponType = "pistol" end
                    if weaponType == "bufalo" and C.Custom_BufaloEnabled then
                        applyWeaponCustomization(item, COLOR_MAP[C.Custom_BufaloColor] or COLOR_MAP.Vermelho, useGlass)
                        anyActive = true
                    elseif weaponType == "pistol" and C.Custom_PistolEnabled then
                        applyWeaponCustomization(item, COLOR_MAP[C.Custom_PistolColor] or COLOR_MAP.Vermelho, useGlass)
                        anyActive = true
                    elseif weaponType == "rifle" and C.Custom_RifleEnabled then
                        applyWeaponCustomization(item, COLOR_MAP[C.Custom_RifleColor] or COLOR_MAP.Vermelho, useGlass)
                        anyActive = true
                    end
                    if C.Custom_Vidrom and not anyActive then
                        for _, d in ipairs(item:GetDescendants()) do
                            if d:IsA("BasePart") or d:IsA("MeshPart") then
                                if not originalWeaponState[d] then
                                    originalWeaponState[d] = { Color = d.Color, Material = d.Material, Transparency = d.Transparency }
                                end
                                d.Material = Enum.Material.Glass
                                d.Transparency = 0.35
                            end
                        end
                    end
                    if weaponType == "pistol" or weaponType == "rifle" then
                        local targetId, targetVol = resolveSoundId(weaponType)
                        for _, s in ipairs(item:GetDescendants()) do
                            if s:IsA("Sound") and isFireSound(s) then
                                if not processedSounds[s] then processedSounds[s] = s.SoundId end
                                if targetId then
                                    if s.SoundId ~= targetId then
                                        s.SoundId = targetId
                                        s.Volume = targetVol
                                    end
                                else
                                    if s.SoundId ~= processedSounds[s] then
                                        s.SoundId = processedSounds[s]
                                        s.Volume = 0.5
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end

local function getActiveTracerColor()
    return LINEB_COLOR_MAP[C.Custom_LineBColor] or LINEB_DEFAULT_COLOR
end
local function processLineBTracer(objeto)
    if not C.Custom_LineB then return end
    local cor = getActiveTracerColor()
    local seq = ColorSequence.new(cor)
    local ehRastro = false
    if objeto:IsA("Beam") then objeto.Color = seq ehRastro = true
    elseif objeto:IsA("Trail") then objeto.Color = seq objeto.Lifetime = LINEB_DURATION ehRastro = true
    elseif objeto:IsA("ParticleEmitter") then objeto.Color = seq objeto.Lifetime = NumberRange.new(LINEB_DURATION) ehRastro = true
    elseif objeto:IsA("BasePart") then
        local n = objeto.Name:lower()
        if n:find("tracer") or n:find("bullet") or objeto.Material == Enum.Material.Neon then
            objeto.Color = cor ehRastro = true
        end
    end
    if ehRastro then
        task.delay(0.05, function()
            if C.Custom_LineB and objeto and objeto.Parent then Debris:AddItem(objeto, LINEB_DURATION) end
        end)
    end
end
